# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
QLOO_API_KEY=
HIVE_API_KEY=
AI_MODEL=deepseek-ai/deepseek-v4.1-flash-1017

# Use at least 32 random characters; keep the same value across app instances.
SESSION_SECRET=

# Optional private judging-priority code, at least 32 random characters.
# Public visitors retain all features; this only reserves execution capacity.
JUDGE_ACCESS_CODE=

# Private Vercel Cron authentication for daily canonical-sample maintenance.
CRON_SECRET=

# Provider-managed Upstash for Redis bindings from Vercel Marketplace.
# Local integration bindings can also be pulled into ignored .env.shared.local.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional public map style URL. The default is OpenFreeMap Liberty.
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
