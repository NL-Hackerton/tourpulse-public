{
  "name": "tourpulse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test src/lib/*.test.ts",
    "warm:samples": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.shared.local --env-file-if-exists=.env.production.local --conditions=react-server --import tsx scripts/warm-samples.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.74",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "ai": "7.0.146",
    "botid": "1.5.11",
    "lucide-react": "1.59.0",
    "maplibre-gl": "6.15.0",
    "next": "16.4.2",
    "ngeohash": "0.6.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/ngeohash": "0.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3"
  }
